# Generate at least 32 random bytes and keep the real value out of git.
TODODODO_CSRF_SECRET=replace-with-at-least-32-random-bytes

# Exact browser origins, comma-separated and without trailing slashes.
TODODODO_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Use false only for local HTTP. Deployed HTTPS environments must omit this or set true.
TODODODO_COOKIE_SECURE=false

# Hosted Edge Functions receive SUPABASE_URL and legacy SUPABASE_ANON_KEY automatically.
# Prefer an explicit publishable key when using the new key format.
TODODODO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
