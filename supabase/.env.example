# Local Edge Function configuration. Supabase injects SUPABASE_URL and
# SUPABASE_ANON_KEY automatically when functions are served locally.
TODODODO_CSRF_SECRET=replace-with-at-least-32-random-bytes
TODODODO_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TODODODO_COOKIE_SECURE=false

# Optional: use a current publishable key instead of the runtime ANON key.
# TODODODO_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
