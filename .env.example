# Server-only Expo API proxy configuration. Never prefix these with EXPO_PUBLIC.
SUPABASE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/todododo-api
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Exact browser origins, comma-separated and without trailing slashes.
TODODODO_PUBLIC_ORIGINS=https://todo.example
