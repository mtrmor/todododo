# Server-only Expo API proxy configuration. Never prefix these with EXPO_PUBLIC.
SUPABASE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/todododo-api
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Exact browser origins, comma-separated and without trailing slashes.
TODODODO_PUBLIC_ORIGINS=https://todo.example

# Native-only Supabase configuration. These values are embedded in iOS/Android builds.
# For the iOS Simulator, 127.0.0.1 reaches the Mac hosting local Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/todododo-api
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
